# Deployment settings for scripts/deploy_site.sh and scripts/push_archives.sh.
#
# Copy to .env (untracked, already gitignored) and fill in your own values. The
# scripts read KEY=value lines from it without executing the file, and anything
# already exported in your shell wins over what is written here.
#
# One credential is deliberately absent: the R2 access key and secret. rclone
# holds those in ~/.config/rclone/rclone.conf and the scripts name only the
# remote, so the key never reaches an environment variable or a process list.

# Public base URL the .pmtiles archives are served from, including this city's
# path prefix. Written into the deployed manifest, so it is public either way.
# The prefix is what lets one bucket serve several cities: uploads are flat, so
# without it two cities' archives share one namespace.
AUTOGEOREF_TILES_BASE=https://tiles.example.com/chicago

# R2 bucket the archives are uploaded into.
AUTOGEOREF_R2_BUCKET=example-bucket

# Cloudflare Pages project the viewer bundle is deployed to.
AUTOGEOREF_PAGES_PROJECT=example-project

# Public base URL the PAGE is served at — the custom domain, not the pages.dev
# alias, because this is the URL that goes into og:url, the canonical link and
# sitemap.xml. Optional: without it the share card still carries a title and a
# description, and the tags needing an absolute URL are left out rather than
# pointed at the wrong host.
AUTOGEOREF_SITE_URL=https://example.com

# Mapbox PUBLIC token (pk.…) restricted to the deployment's URL. deploy-bundle
# regenerates config.js from it on every run, so without it the rebuilt page
# ships with address search switched off.
AUTOGEOREF_MAPBOX_TOKEN=pk.replace-me

# rclone remote holding the R2 credentials. Optional, defaults to r2.
#AUTOGEOREF_R2_REMOTE=r2

# Origin the deploy's verification step asks the archives with, to tell a CORS
# problem apart from a missing file. Optional, defaults to the Pages project's
# own pages.dev origin.
#AUTOGEOREF_PAGES_ORIGIN=https://example-project.pages.dev

# Needed only by --replace, which purges the replaced archive's URL from the
# edge cache. The zone is the one holding the tiles hostname, not the bucket.
# The API token is a secret: keep it in .env, never on a command line.
#AUTOGEOREF_CF_ZONE_ID=
#CLOUDFLARE_API_TOKEN=

# Multipart part size and parallel transfers for the upload. Optional; rclone
# buffers part size x transfers x upload concurrency, so lower the part size if
# that is more memory than you have.
#AUTOGEOREF_R2_CHUNK_SIZE=64M
#AUTOGEOREF_R2_TRANSFERS=4
